    "description": "Consumer care contact information (name/address/phone/email) must be declared",
    "validation_logic": {
      "type": "presence_check",
      "field": "consumer_care_info"
    },
    "legal_reference": "Rule 6(1)(l) — Legal Metrology (Packaged Commodities) Rules, 2011",
    "citation_verified": false,
