[
  {
    "rule_id": "NAME-001",
    "field": "commodity_name",
    "category": null,
    "mandatory": true,
    "severity": "HIGH",
    "description": "Common or generic name of the commodity must be declared on every package",
    "validation_logic": {
      "type": "presence_check",
      "field": "commodity_name"
    },
    "legal_reference": "Rule 6(1)(a) — Legal Metrology (Packaged Commodities) Rules, 2011",
    "citation_verified": false,
    "package_type": "any",
    "rule_version": "1.0"
  },
  {
    "rule_id": "MRP-001",
    "field": "mrp",
    "category": null,
    "mandatory": true,
    "severity": "HIGH",
    "description": "Maximum Retail Price (MRP) must be declared on every pre-packaged commodity",
    "validation_logic": {
      "type": "presence_check",
      "field": "mrp"
    },
    "legal_reference": "Rule 6(1)(f) — Legal Metrology (Packaged Commodities) Rules, 2011",
    "citation_verified": false,
    "package_type": "retail",
    "rule_version": "1.0"
  },
  {
    "rule_id": "MRP-002",
    "field": "mrp",
    "category": null,
    "mandatory": true,
    "severity": "HIGH",
    "description": "MRP declaration must state the retail price with statutory currency indicator and amount",
    "validation_logic": {
      "type": "format_check",
      "pattern": "(?:(?:M\\.?R\\.?P\\.?|Maximum\\s+Retail\\s+Price)\\s*:?\\s*(?:(?:Rs\\.?|₹|INR)\\s*)?(?:[0-9]{1,3}(?:,[0-9]{2,3})*(?:\\.[0-9]{1,2})?\\s*(?:/-)?)?|(?:Rs\\.?|₹|INR)\\s*[0-9]{1,3}(?:,[0-9]{2,3})*(?:\\.[0-9]{1,2})?\\s*(?:/-)?)",
      "case_insensitive": true
    },
    "legal_reference": "Rule 6(1)(f) — Legal Metrology (Packaged Commodities) Rules, 2011",
    "citation_verified": false,
    "package_type": "retail",
    "rule_version": "1.1"
  },
  {
    "rule_id": "MRP-003",
    "field": "mrp",
    "category": null,
    "mandatory": true,
    "severity": "MEDIUM",
    "description": "MRP declaration must not be obscured, overprinted or struck through",
    "validation_logic": {
      "type": "visibility_check",
      "field": "mrp"
    },
    "legal_reference": "Rule 6(1)(f) — Legal Metrology (Packaged Commodities) Rules, 2011",
    "citation_verified": false,
    "package_type": "retail",
    "rule_version": "1.0"
  },
  {
    "rule_id": "TAX-001",
    "field": "mrp",
    "category": null,
    "mandatory": true,
    "severity": "MEDIUM",
    "description": "Maximum Retail Price must carry inclusive of all taxes wording",
    "validation_logic": {
      "type": "format_check",
      "pattern": "(?:incl(?:usive)?\\.?\\s+of\\s+all\\s+taxes|incl\\.\\s*all\\s*taxes)",
      "case_insensitive": true
    },
    "legal_reference": "Rule 6(1)(f) — Legal Metrology (Packaged Commodities) Rules, 2011",
    "citation_verified": false,
    "package_type": "retail",
    "rule_version": "1.0"
  },
  {
    "rule_id": "USP-001",
    "field": "unit_sale_price",
    "category": null,
    "mandatory": false,
    "severity": "MEDIUM",
    "description": "Unit sale price must be declared where package contains more than one unit or specified weight/volume",
    "validation_logic": {
      "type": "conditional_check",
      "condition": "requires_usp",
      "field": "unit_sale_price"
    },
    "legal_reference": "Rule 6(1)(g) — Legal Metrology (Packaged Commodities) Rules, 2011 (GSR 779(E))",
    "citation_verified": false,
    "package_type": "retail",
    "rule_version": "1.0"
  },
  {
    "rule_id": "NQ-001",
    "field": "net_quantity",
    "category": null,
    "mandatory": true,
    "severity": "HIGH",
    "description": "Net quantity must be declared on all pre-packaged commodities",
    "validation_logic": {
      "type": "presence_check",
      "field": "net_quantity"
    },
    "legal_reference": "Rule 6(1)(b) — Legal Metrology (Packaged Commodities) Rules, 2011",
    "citation_verified": false,
    "package_type": "any",
    "rule_version": "1.0"
  },
  {
    "rule_id": "NQ-002",
    "field": "net_quantity",
    "category": null,
    "mandatory": true,
    "severity": "MEDIUM",
    "description": "Net quantity must be expressed in standard legal units: g, kg, ml, l, cm, m, nos",
    "validation_logic": {
      "type": "unit_check",
      "allowed_units": ["g", "gm", "gram", "kg", "kilogram", "ml", "l", "ltr", "litre", "cm", "m", "nos", "pcs", "units", "number"]
    },
    "legal_reference": "Rule 7 & Rule 12 — Legal Metrology (Packaged Commodities) Rules, 2011",
    "citation_verified": false,
    "package_type": "any",
    "rule_version": "1.0"
  },
  {
    "rule_id": "MFR-001",
    "field": "manufacturer_name",
    "category": null,
    "mandatory": true,
    "severity": "HIGH",
    "description": "Name of the manufacturer, packer, or importer must be declared on the package",
    "validation_logic": {
      "type": "presence_check",
      "field": "manufacturer_name"
    },
    "legal_reference": "Rule 6(1)(c) — Legal Metrology (Packaged Commodities) Rules, 2011",
    "citation_verified": false,
    "package_type": "any",
    "rule_version": "1.0"
  },
  {
    "rule_id": "MFR-002",
    "field": "manufacturer_address",
    "category": null,
    "mandatory": true,
    "severity": "HIGH",
    "description": "Complete postal address including PIN code of manufacturer/packer must be declared",
    "validation_logic": {
      "type": "presence_check",
      "field": "manufacturer_address"
    },
    "legal_reference": "Rule 6(1)(c) — Legal Metrology (Packaged Commodities) Rules, 2011",
    "citation_verified": false,
    "package_type": "any",
    "rule_version": "1.0"
  },
  {
    "rule_id": "DATE-001",
    "field": "manufacturing_date",
    "category": null,
    "mandatory": true,
    "severity": "HIGH",
    "description": "Month and year of manufacture or packing must be declared",
    "validation_logic": {
      "type": "presence_check",
      "field": "manufacturing_date",
      "format": "month_year"
    },
    "legal_reference": "Rule 6(1)(e) — Legal Metrology (Packaged Commodities) Rules, 2011",
    "citation_verified": false,
    "package_type": "retail",
    "rule_version": "1.0"
  },
  {
    "rule_id": "DATE-002",
    "field": "best_before_date",
    "category": null,
    "mandatory": false,
    "severity": "MEDIUM",
    "description": "Best before / use by date should be declared for perishable commodities",
    "validation_logic": {
      "type": "conditional_check",
      "condition": "is_perishable",
      "field": "best_before_date"
    },
    "legal_reference": "Rule 6(1)(e) — Legal Metrology (Packaged Commodities) Rules, 2011",
    "citation_verified": false,
    "package_type": "retail",
    "rule_version": "1.0"
  },
  {
    "rule_id": "BATCH-001",
    "field": "batch_number",
    "category": null,
    "mandatory": true,
    "severity": "MEDIUM",
