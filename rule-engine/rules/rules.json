  },
  {
    "rule_id": "COO-001",
    "field": "country_of_origin",
    "category": null,
    "mandatory": false,
    "severity": "MEDIUM",
    "description": "Country of origin must be declared for imported commodities",
    "validation_logic": {
      "type": "conditional_check",
      "condition": "is_imported",
      "field": "country_of_origin"
    },
    "legal_reference": "Rule 6(1)(k) — Legal Metrology (PC) Rules 2011 & Consumer Protection Rules",
    "citation_verified": false,
    "package_type": "retail",
    "rule_version": "1.0"
  },
  {
    "rule_id": "PLACE-001",
    "field": "placement",
    "category": null,
    "mandatory": true,
    "severity": "MEDIUM",
    "description": "All mandatory declarations must be grouped together on a single principal display panel",
    "validation_logic": {
      "type": "placement_check",
      "target_fields": ["commodity_name", "mrp", "net_quantity", "manufacturer_name", "manufacturing_date", "consumer_care_info"]
    },
    "legal_reference": "Rule 6(2) & Rule 9 — Legal Metrology (Packaged Commodities) Rules, 2011",
    "citation_verified": false,
    "package_type": "retail",
    "rule_version": "1.0"
  },
  {
    "rule_id": "FONT-001",
    "field": "font_size",
    "category": null,
    "mandatory": true,
    "severity": "MEDIUM",
    "description": "Declarations must be in legible font size as specified by applicable rules",
    "validation_logic": {
      "type": "font_size_check",
      "min_height_mm": 1.0,
      "reference": "barcode_dimension"
    },
    "legal_reference": "Rule 6(4) — Legal Metrology (Packaged Commodities) Rules, 2011",
    "citation_verified": false,
    "package_type": "retail",
    "rule_version": "1.0"
  }
]
