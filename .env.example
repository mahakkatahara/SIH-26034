# =============================================================================
# SIH-26034 Legal Metrology Inspection System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development               # development | production
APP_NAME="Legal Metrology Inspection System"
APP_VERSION=1.0.0
DEBUG=true

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (PostgreSQL) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=legal_metrology_db
POSTGRES_USER=lmis_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://lmis_user:CHANGE_ME_STRONG_PASSWORD@db:5432/legal_metrology_db

# --- Redis (caching, rate-limiting) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT Authentication ---
JWT_SECRET_KEY=CHANGE_ME_32_CHAR_RANDOM_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- File Storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/tiff

# --- AI Pipeline ---
AI_PIPELINE_MODE=stub             # stub | paddleocr | custom
AI_CONFIDENCE_THRESHOLD=0.75      # Below this → "Human verification recommended"
AI_STUB_DELAY_SECONDS=2           # Simulated processing delay in stub mode

# --- Rule Engine ---
RULES_FILE_PATH=../rule-engine/rules/rules.json
RULE_ENGINE_VERSION=1.0.0

# --- Reports ---
REPORT_OUTPUT_DIR=./reports/output
REPORT_LOGO_PATH=./reports/assets/logo.png

# --- LLM / RAG (Phase 7 — not used in Phase 1) ---
LLM_ENABLED=false
LLM_PROVIDER=                     # openai | gemini | ollama
LLM_API_KEY=
LLM_MODEL=
VECTOR_DB_PATH=./data/vectordb

# --- Email (optional notifications) ---
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Logging ---
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                   # json | text
